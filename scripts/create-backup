#!/bin/bash
set -e

# ============================================
# СКРИПТ БЭКАПА БАЗЫ ДАННЫХ
# Использование: ./create-backup
# ============================================

# Загружаем переменные из .env
if [ -f .env ]; then
    export $(grep -v '^#' .env | xargs)
fi

# Контейнер и параметры БД
DB_CONTAINER="${DB_CONTAINER:-video_stats_db}"
DB_USER="${DB_USER:-admin}"
DB_NAME="${DB_NAME:-hackaton_db}"

# Папка для бэкапов
BACKUP_DIR="backups"
mkdir -p "$BACKUP_DIR"

# Имя файла с датой
BACKUP_FILE="$BACKUP_DIR/backup_$(date +%F_%H-%M-%S).sql"

echo "📦 Создание бэкапа базы данных..."
echo "Контейнер: $DB_CONTAINER"
echo "База: $DB_NAME"
echo "Файл: $BACKUP_FILE"
echo ""

# Проверяем, что контейнер запущен
if docker ps --format '{{.Names}}' | grep -q "$DB_CONTAINER"; then
    docker exec "$DB_CONTAINER" pg_dump -U "$DB_USER" -d "$DB_NAME" > "$BACKUP_FILE"

    if [ -s "$BACKUP_FILE" ]; then
        echo "✅ Бэкап сохранён: $BACKUP_FILE"
        echo "📏 Размер: $(du -h "$BACKUP_FILE" | cut -f1)"
    else
        echo "❌ Ошибка: бэкап пустой"
        rm -f "$BACKUP_FILE"
        exit 1
    fi
else
    echo "❌ Ошибка: контейнер '$DB_CONTAINER' не запущен"
    echo "Запущенные контейнеры:"
    docker ps --format '  - {{.Names}}'
    exit 1
fi

# Показываем последние бэкапы
echo ""
echo "📂 Последние бэкапы:"
ls -lh "$BACKUP_DIR" | tail -5